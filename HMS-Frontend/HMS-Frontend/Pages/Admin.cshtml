@page
@model HMS_Frontend.Pages.AdminModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hospital Management System — Admin</title>

    <style>
        :root {
            --bg-grad-1: #f4f9ff;
            --bg-grad-2: #e8f3ff;
            --sidebar-top: #3e4754;
            --sidebar-bottom: #2e3641;
            --text: #1a1f29;
            --muted: #6b7280;
            --card: #ffffff;
            --border: #e6e8ec;
            --brand: #2f3b4a;
            --brand-2: #394556;
            --success: #11a36a;
            --danger: #e14b4b;
            --warning: #e6a23c;
            --shadow: 0 8px 24px rgba(14, 30, 64, .06);
            --radius: 16px;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            height: 100%;
        }

        body {
            margin: 0;
            font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
            color: var(--text);
            background: radial-gradient(1200px 600px at 15% -10%, var(--bg-grad-2), var(--bg-grad-1) 60%);
        }

        .shell {
            display: grid;
            grid-template-columns: 280px 1fr;
            min-height: 100vh;
        }

        /* Sidebar */
        .sidebar {
            background: linear-gradient(180deg, var(--sidebar-top), var(--sidebar-bottom));
            color: #ecf0f6;
            padding: 28px 18px;
            position: sticky;
            top: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            gap: 18px;
        }

        .brand {
            font-weight: 700;
            font-size: 22px;
            text-align: center;
            margin-bottom: 8px;
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

            .nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 16px;
                border-radius: 12px;
                color: #e9edf4;
                text-decoration: none;
                background: transparent;
                transition: all .15s ease;
            }

                .nav a.active, .nav a:hover {
                    background: rgba(255,255,255,.06);
                    box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
                }

        .sidebar-bottom {
            margin-top: auto;
        }

        /* Main */
        .main {
            padding: 28px 28px 48px;
        }

        h1 {
            margin: 0;
            font-weight: 800;
            font-size: 26px;
        }

        .page-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        /* Cards */
        .card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .card-header {
            padding: 16px 18px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .card-body {
            padding: 18px;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            border: 0;
            border-radius: 12px;
            padding: 12px 16px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            background: var(--brand);
            color: #fff;
            transition: all .2s ease;
        }

            .btn:hover {
                filter: brightness(1.05);
            }

            .btn.secondary {
                background: var(--brand-2);
            }

            .btn.success {
                background: var(--success);
            }

            .btn.danger {
                background: var(--danger);
            }

            .btn.warning {
                background: var(--warning);
            }

            .btn.small {
                padding: 8px 10px;
                font-size: 13px;
            }

        .pill {
            display: inline-flex;
            align-items: center;
            padding: 4px 10px;
            background: #f1f5ff;
            color: #2b3d59;
            border: 1px solid #e2e8f5;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
        }

        /* Table */
        .table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 14px;
            border: 1px solid var(--border);
            border-radius: 12px;
            overflow: hidden;
        }

            .table th, .table td {
                padding: 14px;
                background: #fff;
            }

            .table thead th {
                background: #f6f8fc;
                color: #4b5563;
                text-align: left;
                font-weight: 800;
                font-size: 12px;
                letter-spacing: .08em;
                text-transform: uppercase;
                border-bottom: 1px solid var(--border);
            }

            .table tbody tr + tr td {
                border-top: 1px solid var(--border);
            }

        /* Modal */
        .modal {
            position: fixed;
            inset: 0;
            background: rgba(17, 24, 39, .45);
            display: none;
            place-items: center;
            z-index: 50;
        }

            .modal:target {
                display: grid;
            }

            .modal .panel {
                width: min(800px, 100%);
                background: var(--card);
                border: 1px solid var(--border);
                border-radius: 20px;
                box-shadow: var(--shadow);
            }

        .panel header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px 18px;
            border-bottom: 1px solid var(--border);
        }

        .panel .content {
            padding: 18px;
        }

        .close-x {
            text-decoration: none;
            display: inline-grid;
            place-items: center;
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #eef2f8;
            color: #334155;
            font-weight: 900;
        }

        /* Forms */
        .row {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 14px;
        }

        .form-field {
            grid-column: span 12;
        }

        @@media (min-width: 900px) {
            .col-6 {
                grid-column: span 6;
            }

            .col-4 {
                grid-column: span 4;
            }

            .col-8 {
                grid-column: span 8;
            }
        }

        label {
            display: block;
            font-size: 13px;
            color: var(--muted);
            margin-bottom: 6px;
        }

        input[type="text"], input[type="email"], input[type="password"], select {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            border: 1px solid var(--border);
            font-size: 14px;
            background: #fbfcfe;
        }

            input:focus, select:focus {
                border-color: #c9d6f3;
            }

        .empty {
            padding: 28px;
            text-align: center;
            color: var(--muted);
            border: 2px dashed #e6e9f2;
            border-radius: 14px;
            background: #fbfdff;
        }
    </style>
</head>

<body>
    <div class="shell">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="brand">Hospital Management System</div>
            <nav class="nav">
                <a class="active" href="#"><span>🏠</span> Home</a>
                <!-- Users removed from nav as requested -->
            </nav>

            <!-- Sign out button at bottom -->
            <div class="sidebar-bottom">
                <form method="post" asp-page-handler="SignOut">
                    @Html.AntiForgeryToken()
                    <button class="btn danger" type="submit">🚪 Sign out</button>
                </form>
            </div>
        </aside>

        <!-- Main -->
        <main class="main">
            <div class="page-title">
                <h1>Admin Dashboard</h1>
                <a class="btn" href="#addUserModal">➕ Add New User</a>
            </div>

            <section class="card">
                <div class="card-header">
                    <h2>Manage Users</h2>
                </div>
                <div class="card-body">
                    @if (Model.Users == null || !Model.Users.Any())
                    {
                        <div class="empty">No users found. Click <b>Add New User</b> to create one.</div>
                    }
                    else
                    {
                        <div style="overflow:auto;">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Name</th>
                                        <th>Email</th>
                                        <th>Username</th>
                                        <th>Role</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var u in Model.Users)
                                    {
                                        <tr>
                                            <td>@u.FullName</td>
                                            <td>@u.Email</td>
                                            <td>@u.Username</td>
                                            <td><span class="pill">@u.Role</span></td>
                                            <td>
                                                @if (u.IsActive)
                                                {
                                                    <span class="pill" style="background:#ecfdf5;border-color:#d1fae5;color:#065f46;">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="pill" style="background:#fff7ed;border-color:#ffedd5;color:#92400e;">Deactivated</span>
                                                }
                                            </td>
                                            <td>
                                                <a class="btn small secondary" href="#view-@u.Id">👁️ View</a>
                                                <a class="btn small secondary" href="#edit-@u.Id">✏️ Update</a>

                                                @if (u.IsActive)
                                                {
                                                    <form method="post" asp-page-handler="Deactivate" style="display:inline" onsubmit="return confirm('Deactivate this user?');">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="Id" value="@u.Id" />
                                                        <button class="btn small warning" type="submit">⏸️ Deactivate</button>
                                                    </form>
                                                }
                                                else
                                                {
                                                    <!-- API exposes only PATCH /deactivate; no re-activate endpoint available -->
                                                    <span class="pill">No actions</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- VIEW & EDIT MODALS (outside table) -->
                        @foreach (var u in Model.Users)
                        {
                            <!-- View -->
                            <div id="view-@u.Id" class="modal">
                                <div class="panel">
                                    <header>
                                        <h3>User Details — @u.FullName</h3>
                                        <a class="close-x" href="#">✕</a>
                                    </header>
                                    <div class="content">
                                        <div class="row">
                                            <div class="form-field col-6">
                                                <label>Full Name</label>
                                                <input type="text" value="@u.FullName" disabled />
                                            </div>
                                            <div class="form-field col-6">
                                                <label>Role</label>
                                                <input type="text" value="@u.Role" disabled />
                                            </div>
                                            <div class="form-field col-6">
                                                <label>Email</label>
                                                <input type="email" value="@u.Email" disabled />
                                            </div>
                                            <div class="form-field col-6">
                                                <label>Username</label>
                                                <input type="text" value="@u.Username" disabled />
                                            </div>
                                            <div class="form-field col-6">
                                                <label>Status</label>
                                                <input type="text" value="@(u.IsActive ? "Active" : "Deactivated")" disabled />
                                            </div>
                                        </div>
                                        <div style="text-align:right; margin-top:14px;">
                                            <a class="btn" href="#">Close</a>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Edit / Update -->
                            <div id="edit-@u.Id" class="modal">
                                <div class="panel">
                                    <header>
                                        <h3>Update User — @u.FullName</h3>
                                        <a class="close-x" href="#">✕</a>
                                    </header>
                                    <div class="content">
                                        <form method="post" asp-page-handler="Update">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="Id" value="@u.Id" />
                                            <div class="row">
                                                <div class="form-field col-6">
                                                    <label>Full Name</label>
                                                    <input type="text" name="FullName" value="@u.FullName" required />
                                                </div>
                                                <div class="form-field col-6">
                                                    <label>Role</label>
                                                    <select name="Role">
                                                        <option value="Receptionist" selected="@(u.Role == "Receptionist")">Receptionist</option>
                                                        <option value="Nurse" selected="@(u.Role == "Nurse")">Nurse</option>
                                                        <option value="Doctor" selected="@(u.Role == "Doctor")">Doctor</option>
                                                        <option value="Admin" selected="@(u.Role == "Admin")">Admin</option>
                                                    </select>
                                                </div>
                                                <div class="form-field col-6">
                                                    <label>Email</label>
                                                    <input type="email" name="Email" value="@u.Email" required />
                                                </div>
                                                <div class="form-field col-6">
                                                    <label>Username</label>
                                                    <input type="text" name="Username" value="@u.Username" required />
                                                </div>
                                            </div>
                                            <div style="text-align:right; margin-top:14px;">
                                                <a class="btn" href="#">Cancel</a>
                                                <button class="btn success" type="submit">💾 Save</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </section>
        </main>
    </div>

    <!-- Add User Modal -->
    <div id="addUserModal" class="modal">
        <div class="panel">
            <header>
                <h3>Add New User</h3>
                <a class="close-x" href="#">✕</a>
            </header>
            <div class="content">
                <!-- POST /api/users -->
                <form method="post" asp-page-handler="Create">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="form-field col-6">
                            <label>Full Name</label>
                            <input type="text" name="FullName" required />
                        </div>
                        <div class="form-field col-6">
                            <label>Role</label>
                            <select name="Role" required>
                                <option value="Receptionist">Receptionist</option>
                                <option value="Nurse">Nurse</option>
                                <option value="Doctor">Doctor</option>
                                <option value="Admin">Admin</option>
                            </select>
                        </div>
                        <div class="form-field col-6">
                            <label>Email</label>
                            <input type="email" name="Email" required />
                        </div>
                        <div class="form-field col-6">
                            <label>Username</label>
                            <input type="text" name="Username" required />
                        </div>
                        <div class="form-field col-6">
                            <label>Password</label>
                            <input type="password" name="Password" required />
                        </div>
                    </div>
                    <div style="text-align:right; margin-top:14px;">
                        <a class="btn" href="#">Cancel</a>
                        <button class="btn success" type="submit">➕ Create User</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

</body>
</html>
