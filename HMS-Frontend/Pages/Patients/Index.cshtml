@page
@model HMS_Frontend.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Patients";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.3.0/fonts/remixicon.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <style>
        :root {
            --bg: #0f172a;
            --card: #0b1222e6;
            --accent: #22d3ee;
            --text: #f8fafc; /* Slate 50 - Brighter */
            --muted: #cbd5e1; /* Slate 300 - More readable */
            --line: #1f2937;
            --radius-xl: 18px;
            --radius: 12px;
            --shadow-md: 0 6px 20px rgba(0,0,0,.25);
            --blur: saturate(140%) blur(10px)
        }

        body {
            background: radial-gradient(1200px 600px at 10% -10%,#0ea5e944,transparent 60%),var(--bg);
            color: var(--text);
            font-family: "Inter",sans-serif;
        }

        .card {
            background: var(--card);
            border: 1px solid #1f2a44;
            border-radius: var(--radius-xl);
            padding: 24px;
            backdrop-filter: var(--blur);
            margin-bottom: 20px;
        }

        h2 {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #000000; /* Black text as requested */
            text-shadow: none;
        }

        table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        thead th {
            text-align: left;
            font-size: 12px;
            color: #cbd5e1; /* Slate 300 */
            font-weight: 700;
            padding: 0 12px 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        tbody tr {
            background: #1e293bcc;
            transition: transform 0.15s;
        }

            tbody tr:hover {
                transform: translateY(-2px);
                background: #25334bcc;
            }

        tbody td {
            padding: 16px 12px;
            border-top: 1px solid #1f2a44;
            border-bottom: 1px solid #1f2a44;
            color: #f1f5f9; /* Slate 100 */
        }

            tbody td:first-child {
                border-left: 1px solid #1f2a44;
                border-top-left-radius: 12px;
                border-bottom-left-radius: 12px;
            }

            tbody td:last-child {
                border-right: 1px solid #1f2a44;
                border-top-right-radius: 12px;
                border-bottom-right-radius: 12px;
            }

        .btn {
            background: var(--accent);
            border: none;
            padding: 8px 16px;
            border-radius: 8px;
            color: #0f172a; /* Darker text on accent button for contrast */
            font-weight: 600;
            cursor: pointer;
            transition: .15s;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 0.9rem;
        }

            .btn:hover {
                transform: translateY(-1px);
                filter: brightness(1.1);
            }

        .btn-secondary {
            background: #334155;
            color: #f8fafc;
        }

        .btn-danger {
            background: #ef4444;
            color: white;
        }

            .btn-danger:hover {
                background: #dc2626;
            }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .full {
            grid-column: 1 / -1;
        }

        .form-label {
            display: block;
            font-size: 0.85rem;
            color: #cbd5e1; /* Slate 300 */
            margin-bottom: 6px;
        }

        .form-control {
            width: 100%;
            padding: 10px 12px;
            border-radius: 8px;
            border: 1px solid #334155;
            background: #0f172a;
            color: #f8fafc; /* Slate 50 */
            outline: none;
        }

            .form-control:focus {
                border-color: var(--accent);
            }
    </style>
}

<div class="container" style="padding-top: 20px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Patients</h2>
        <div class="d-flex gap-2">
            <button onclick="openAddModal()" class="btn">
                <i class="ri-user-add-line"></i> Add New Patient
            </button>
            <a asp-page="/Dashboard" class="btn btn-secondary">
                <i class="ri-arrow-left-line"></i> Back to Dashboard
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Please correct the following errors:</strong>
            <div asp-validation-summary="All" class="mb-0"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <!-- Patient List & Search -->
        <div class="col-md-8">
            <div class="card">
                <form method="get" class="d-flex gap-2 mb-4">
                    <input type="text" class="form-control" asp-for="SearchQuery" placeholder="Search by name..." style="max-width: 300px;">
                    <button type="submit" class="btn btn-secondary">Search</button>
                </form>

                @if (Model.Patients.Any())
                {
                    <table>
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>DOB</th>
                                <th>Contact</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in Model.Patients)
                            {
                                <tr style="@(Model.SelectedPatientId == patient.Id ? "background: #25334bcc;" : "")">
                                    <td>
                                        <a asp-page="./Index" asp-route-patientId="@patient.Id" asp-route-SearchQuery="@Model.SearchQuery" style="color: #38bdf8; font-weight: 600; text-decoration: none;">
                                            @patient.FirstName @patient.LastName
                                        </a>
                                    </td>
                                    <td>@patient.DateOfBirth.ToShortDateString()</td>
                                    <td>
                                        <div style="font-size: 0.85rem; color: #94a3b8;">
                                            <div><i class="ri-mail-line"></i> @patient.Email</div>
                                            <div><i class="ri-phone-line"></i> @patient.Phone</div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-2">
                                            <a asp-page="./Index" asp-route-patientId="@patient.Id" asp-route-SearchQuery="@Model.SearchQuery" class="btn btn-secondary" style="padding: 6px 10px;" title="View Details">
                                                <i class="ri-eye-line"></i>
                                            </a>
                                            <button type="button" class="btn" style="padding: 6px 10px;"
                                                    onclick="openEditModal(@patient.Id, '@patient.FirstName', '@patient.LastName', '@patient.DateOfBirth.ToString("yyyy-MM-dd")', '@patient.Email', '@patient.Phone', '@patient.Address')">
                                                <i class="ri-edit-line"></i>
                                            </button>
                                            <form method="post" asp-page-handler="DeletePatient" asp-route-id="@patient.Id" onsubmit="return confirm('Are you sure you want to delete this patient?');" style="display:inline;">
                                                <button type="submit" class="btn btn-danger" style="padding: 6px 10px;">
                                                    <i class="ri-delete-bin-line"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div style="text-align: center; padding: 40px; color: #94a3b8;">
                        <i class="ri-user-search-line" style="font-size: 48px; margin-bottom: 10px; display: block;"></i>
                        <p>No patients found. Try searching for a name.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Patient Details & Notes -->
        <!-- Patient Details & Notes -->
        <div class="col-md-4">
            @if (Model.SelectedPatientId.HasValue && Model.SelectedPatientSummary != null)
            {
                <div class="card" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                    <h3 style="color: #000000; margin-top: 0; margin-bottom: 16px; font-size: 1.2rem;">Patient Summary</h3>
                    <h4 class="mb-3" style="color: #0f172a;">@Model.SelectedPatientSummary.FullName</h4>

                    <div style="display: flex; flex-direction: column; gap: 10px; color: #334155;">
                        <div>
                            <strong style="color: #000000;"><i class="ri-calendar-line"></i> DOB:</strong> @Model.SelectedPatientSummary.DateOfBirth.ToShortDateString()
                        </div>
                        <div>
                            <strong style="color: #000000;"><i class="ri-phone-line"></i> Phone:</strong> @Model.SelectedPatientSummary.Phone
                        </div>
                        <div>
                            <strong style="color: #000000;"><i class="ri-mail-line"></i> Email:</strong> @Model.SelectedPatientSummary.Email
                        </div>
                        <div>
                            <strong style="color: #000000;"><i class="ri-map-pin-line"></i> Address:</strong> @Model.SelectedPatientSummary.Address
                        </div>
                    </div>

                    <hr style="border-color: #cbd5e1; margin: 20px 0;" />

                    <h6 style="color: #64748b; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 1px; margin-bottom: 12px;">Upcoming Appointments</h6>
                    @if (Model.SelectedPatientSummary.Appointments.Any())
                    {
                        <div style="display: flex; flex-direction: column; gap: 10px;">
                            @foreach (var appt in Model.SelectedPatientSummary.Appointments)
                            {
                                <div style="background: #fff; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div>
                                            <strong style="color: #0f172a;">@appt.StartsAt.ToString("MMM dd, HH:mm")</strong>
                                            <br />
                                            <small style="color: #64748b;">@appt.Reason</small>
                                        </div>
                                        <span class="status-badge status-scheduled">@appt.Status</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small">No upcoming appointments.</p>
                    }
                </div>

                <div class="card" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                    <h3 style="color: #000000; margin-top: 0; margin-bottom: 16px; font-size: 1.2rem;">Notes</h3>

                    <div class="notes-list mb-3" style="max-height: 300px; overflow-y: auto; padding-right: 5px;">
                        @if (Model.SelectedPatientNotes.Any())
                        {
                            foreach (var note in Model.SelectedPatientNotes)
                            {
                                <div style="background: #fff; padding: 12px; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 10px; box-shadow: 0 1px 2px rgba(0,0,0,0.05);">
                                    <p style="color: #0f172a; font-size: 0.9rem; margin-bottom: 6px;">@note.Text</p>
                                    <div style="color: #64748b; font-size: 0.75rem;">
                                        @note.CreatedAt.ToLocalTime().ToString("g")
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted small text-center">No notes available.</p>
                        }
                    </div>

                    <form method="post" asp-page-handler="AddNote">
                        <input type="hidden" asp-for="NotePatientId" value="@Model.SelectedPatientId" />
                        <input type="hidden" asp-for="SearchQuery" />
                        <div class="mb-2">
                            <textarea class="form-control" asp-for="NewNoteText" rows="3" placeholder="Add a note..." style="background: #fff; color: #0f172a; border: 1px solid #cbd5e1;"></textarea>
                        </div>
                        <button type="submit" class="btn btn-secondary w-100" style="background: #334155; color: #fff;">Add Note</button>
                    </form>
                </div>
            }
            else if (Model.SelectedPatientId.HasValue)
            {
                <div style="padding: 20px; background: #334155; border-radius: 12px; color: #e2e8f0;">
                    Patient summary not found.
                </div>
            }
            else
            {
                <div style="padding: 20px; background: #1e293bcc; border: 1px dashed #334155; border-radius: 12px; color: #94a3b8; text-align: center;">
                    Select a patient to view details and notes.
                </div>
            }
        </div>
    </div>
</div>

<!-- Add Patient Modal -->
<div id="addPatientModal" class="modal-overlay">
    <div class="card" style="width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto;">
        <h3 style="margin-top: 0; color: #fff;">Add New Patient</h3>
        <form method="post" asp-page-handler="AddPatient">
            <div class="form-grid">
                <div>
                    <label asp-for="NewPatient.FirstName" class="form-label">First Name</label>
                    <input asp-for="NewPatient.FirstName" class="form-control" required />
                </div>
                <div>
                    <label asp-for="NewPatient.LastName" class="form-label">Last Name</label>
                    <input asp-for="NewPatient.LastName" class="form-control" required />
                </div>
                <div>
                    <label asp-for="NewPatient.DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="NewPatient.DateOfBirth" type="date" class="form-control" required />
                </div>
                <div>
                    <label asp-for="NewPatient.Email" class="form-label">Email</label>
                    <input asp-for="NewPatient.Email" type="email" class="form-control" />
                </div>
                <div>
                    <label asp-for="NewPatient.Phone" class="form-label">Phone</label>
                    <input asp-for="NewPatient.Phone" class="form-control" />
                </div>
                <div class="full">
                    <label asp-for="NewPatient.Address" class="form-label">Address</label>
                    <textarea asp-for="NewPatient.Address" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn" style="background: transparent; border: 1px solid #ef4444; color: #ef4444;" onclick="closeAddModal()">Cancel</button>
                <button type="submit" class="btn">Create Patient</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Patient Modal -->
<div id="editPatientModal" class="modal-overlay">
    <div class="card" style="width: 100%; max-width: 600px; max-height: 90vh; overflow-y: auto;">
        <h3 style="margin-top: 0; color: #fff;">Edit Patient</h3>
        <form method="post" asp-page-handler="EditPatient">
            <input type="hidden" asp-for="EditPatientId" id="editPatientId" />
            <input type="hidden" asp-for="SearchQuery" />

            <div class="form-grid">
                <div>
                    <label asp-for="EditPatient.FirstName" class="form-label">First Name</label>
                    <input asp-for="EditPatient.FirstName" id="editFirstName" class="form-control" required />
                </div>
                <div>
                    <label asp-for="EditPatient.LastName" class="form-label">Last Name</label>
                    <input asp-for="EditPatient.LastName" id="editLastName" class="form-control" required />
                </div>
                <div>
                    <label asp-for="EditPatient.DateOfBirth" class="form-label">Date of Birth</label>
                    <input asp-for="EditPatient.DateOfBirth" id="editDob" type="date" class="form-control" required />
                </div>
                <div>
                    <label asp-for="EditPatient.Email" class="form-label">Email</label>
                    <input asp-for="EditPatient.Email" id="editEmail" type="email" class="form-control" />
                </div>
                <div>
                    <label asp-for="EditPatient.Phone" class="form-label">Phone</label>
                    <input asp-for="EditPatient.Phone" id="editPhone" class="form-control" />
                </div>
                <div class="full">
                    <label asp-for="EditPatient.Address" class="form-label">Address</label>
                    <textarea asp-for="EditPatient.Address" id="editAddress" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div style="margin-top: 20px; display: flex; justify-content: flex-end; gap: 10px;">
                <button type="button" class="btn" style="background: transparent; border: 1px solid #ef4444; color: #ef4444;" onclick="closeEditModal()">Cancel</button>
                <button type="submit" class="btn">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openAddModal() {
            document.getElementById('addPatientModal').style.display = 'flex';
        }

        function closeAddModal() {
            document.getElementById('addPatientModal').style.display = 'none';
        }

        function openEditModal(id, firstName, lastName, dob, email, phone, address) {
            document.getElementById('editPatientId').value = id;
            document.getElementById('editFirstName').value = firstName;
            document.getElementById('editLastName').value = lastName;
            document.getElementById('editDob').value = dob;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editAddress').value = address;

            document.getElementById('editPatientModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editPatientModal').style.display = 'none';
        }

        // Close modal on outside click
        window.onclick = function(event) {
            var editModal = document.getElementById('editPatientModal');
            var addModal = document.getElementById('addPatientModal');
            if (event.target == editModal) {
                editModal.style.display = "none";
            }
            if (event.target == addModal) {
                addModal.style.display = "none";
            }
        }
    </script>
}
