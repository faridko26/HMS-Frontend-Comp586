@page "/Account/SignIn"
@model HMS_Frontend.Pages.Account.SignInModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign in";
}

<div asp-validation-summary="All" class="validation-summary"></div>

<div class="auth-split">
    <!-- LEFT: Logo / Branding -->
    <section class="auth-left">
        <div class="brand">
            <img src="~/images/healthcare-logo.png" alt="Healthcare logo" class="brand-logo" />
        </div>
    </section>

    <!-- RIGHT: Login form -->
    <section class="auth-right">
        <div class="auth-form">
            <form method="post" asp-page-handler="Login">
                <div class="field">
                    <label asp-for="Login.Username">Username</label>
                    <input asp-for="Login.Username" class="input" />
                    <span class="validation" asp-validation-for="Login.Username"></span>
                </div>

                <div class="field">
                    <label asp-for="Login.Password">Password</label>
                    <input asp-for="Login.Password" type="password" class="input" />
                    <span class="validation" asp-validation-for="Login.Password"></span>
                </div>

                <button type="submit" class="btn-primary">Sign in</button>

                <div class="links">
                    <a asp-page="/ForgotPassword">Forgot password?</a>
                </div>
            </form>
        </div>
    </section>
</div>

<partial name="_ValidationScriptsPartial" />
